@model List<Category>

@{
    ViewData["Title"] = "Kategorier - MewMart";
}

<div class="container">
    <div class="row pt-4 pb-3">
        <div class="col-6">
            <h2 class="text-primary">
                Kategori lista
            </h2>
        </div>
        <div class="col-6 text-end">
            <a asp-controller="Category" asp-action="Create" class="btn-primary text-light">
                <i class="bi bi-plus-circle"></i> Skapa ny kategori
            </a>
        </div>
    </div>

<table class="table table-bordered table-striped">
    <thead>
    <tr>
        <th>
            Kategori Namn
        </th>
        <th>
            Visnings Order
        </th>
    </tr>
    </thead>
    <tbody>
        @foreach(var obj in Model) {
        <tr>
            <td>@obj.Name</td>
            <td>@obj.DisplayOrder</td>
        </tr>
        }
    </tbody>
</table>
</div>