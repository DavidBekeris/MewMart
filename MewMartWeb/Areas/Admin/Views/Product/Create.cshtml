@model MewMart.Models.Product

@{
    ViewData["Title"] = "Skapa produkt - MewMart";
}

<div class="card shadow border my-4">
    <dív class="card-header bg-secondary bg-gradient ml-0 py-3">
        <div class="row">
            <div class="col-12 text-center">
                <h2 class="text-white py-2">
                    Skapa produkt
                </h2>
            </div>
        </div>
    </dív>
    <div class="card-body p-4">
        <form method="post" class="row">
            <div class="border p-3">
                <div asp-validation-summary="All" class="text-danger"></div>
                <div class="form-floating py-2 col-12">
                    <input asp-for="Title" class="form-control border-0 shadow" />
                    <label asp-for="Title" class="ms-2"></label>
                    <span asp-validation-for="Title" class="text-danger"></span>
                </div>
                <div class="form-floating py-2 col-12">
                    <input asp-for="Description" class="form-control border-0 shadow" />
                    <label asp-for="Description" class="ms-2"></label>
                    <span asp-validation-for="Description" class="text-danger"></span>
                </div>
                <div class="form-floating py-2 col-12">
                    <input asp-for="ISBN" class="form-control border-0 shadow" />
                    <label asp-for="ISBN" class="ms-2"></label>
                    <span asp-validation-for="ISBN" class="text-danger"></span>
                </div>                
                <div class="form-floating py-2 col-12">
                    <input asp-for="Manufacturer" class="form-control border-0 shadow" />
                    <label asp-for="Manufacturer" class="ms-2"></label>
                    <span asp-validation-for="Manufacturer" class="text-danger"></span>
                </div>                
                <div class="form-floating py-2 col-12">
                    <input asp-for="ListPrize" class="form-control border-0 shadow" />
                    <label asp-for="ListPrize" class="ms-2"></label>
                    <span asp-validation-for="ListPrize" class="text-danger"></span>
                </div>                
                <div class="form-floating py-2 col-12">
                    <input asp-for="Prize" class="form-control border-0 shadow" />
                    <label asp-for="Prize" class="ms-2"></label>
                    <span asp-validation-for="Prize" class="text-danger"></span>
                </div>                
                <div class="form-floating py-2 col-12">
                    <input asp-for="Prize2" class="form-control border-0 shadow" />
                    <label asp-for="Prize2" class="ms-2"></label>
                    <span asp-validation-for="Prize2" class="text-danger"></span>
                </div>
                <div class="form-floating py-2 col-12">
                    <input asp-for="Prize5" class="form-control border-0 shadow" />
                    <label asp-for="Prize5" class="ms-2"></label>
                    <span asp-validation-for="Prize5" class="text-danger"></span>
                </div>
                <div class="form-floating py-2 col-12">
                    <select asp-for="CategoryId" asp-items="ViewBag.CategoryList" class="form-select border-0 shadow">
                    <option disabled selected>--Välj kategori--</option>
                    </select>
                    <label asp-for="CategoryId" class="ms-2"></label>
                    <span asp-validation-for="CategoryId" class="text-danger"></span>
                </div>
                <div class="row mt-3">
                    <div class="col-6 col-md-3">
                        <button type="submit" class="btn btn-primary form-control">
                            Skapa
                        </button>
                    </div>
                    <div class="col-6 col-md-3">
                        <a asp-controller="Product" asp-action="Index" class="btn btn-outline-primary border form-control">
                            Tillbaka till listan
                        </a>
                    </div>
                </div>
            </div>
        </form>
    </div>
</div>



@section Scripts {
    @{
        <partial name="_ValidationScriptsPartial" />
    }
}
