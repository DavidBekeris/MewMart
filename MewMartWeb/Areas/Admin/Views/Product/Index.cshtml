@using MewMart.Models
@model List<Product>

@{
    ViewData["Title"] = "Produkter - MewMart";
}


<div class="card shadow border my-4">
    <dív class="card-header bg-secondary bg-gradient ml-0 py-3">
        <div class="row">
            <div class="col-12 text-center">
                <h2 class="text-white py-2">
                    Produkt lista
                </h2>
            </div>
        </div>
    </dív>
    <div class="card-body p-4">
        <div class="row pb-3">
            <div class="col-6">
            </div>
            <div class="col-6 text-end">
                <a asp-controller="Product" asp-action="Upsert" class="btn btn-primary">
                    <i class="bi bi-plus-circle"></i> Skapa ny produkt
                </a>
            </div>
        </div>

        <table id="tblData" class="table table-bordered table-striped" style="width:100%">
            <thead>
                <tr>
                    <th>Produkt Namn</th>
                    <th>ISBN</th>
                    <th>Pris</th>
                    <th>Tillverkare</th>
                    <th>Kategori</th>
                    <th></th>
                </tr>
            </thead>
        </table>
    </div>
</div>

@section Scripts {
    <script src="~/js/product.js"></script>
}